 "html": "<div class=\"receipt\" style=\"width: 100%; padding: 5mm; font-family: Arial, sans-serif;\">\r\n  {% if doc.party_type == 'Donor' %}\r\n  <div style=\"display: flex; flex-wrap: wrap; gap: 5mm;\">\r\n    {% for copy in range(3) %}\r\n    <div style=\"width: calc(33.33% - 3.33mm); padding: 5mm; border: 1px solid #ddd; border-radius: 5px; box-sizing: border-box;\">\r\n      <div style=\"text-align: center; margin-bottom: 5mm;\">\r\n        <div style=\"font-size: 16px; font-weight: bold; color: #2c3e50;\">SAYLANI WELFARE INTERNATIONAL TRUST1</div>\r\n        <div style=\"font-size: 10px; color: #7f8c8d; margin-top: 3px;\">Address: A-25, off Bahadur Shah Zafar Road, near\r\n          Grappetite Chowrangi,<br>Bahadurabad Bahadur Yar Jang CHS, Karachi.</div>\r\n        <div style=\"font-size: 14px; font-weight: bold; color: #2c3e50; margin-top: 5px;\">{{ doc.party_type | upper }}\r\n          GATE PASS</div>\r\n      </div>\r\n\r\n      <div style=\"margin-bottom: 5mm;\">\r\n        <div style=\"background: #f8f9fa; padding: 5px; border-radius: 5px; border: 1px solid #ddd;\">\r\n          <div><strong>Date:</strong> {{ frappe.utils.now_datetime() }}</div>\r\n          <div><strong>Gate Pass Number:</strong> {{ doc.name }}</div>\r\n          <div><strong>Warehouse:</strong> {{ doc.slaughter }}</div>\r\n\r\n          {% if doc.party_type == 'Donor' %}\r\n          <div><strong>Name:</strong> {{ doc.donor_name }}</div>\r\n          <div><strong>DN No:</strong> {{ doc.dn_no }}</div>\r\n          <div><strong>DN Branch:</strong> {{ doc.branch }}</div>\r\n          <div><strong>Category:</strong> {{ doc.category }}</div>\r\n          <div><strong>Cutting Charges:</strong> {{ doc.cutting_charges }}</div>\r\n\r\n          {% elif doc.party_type == 'Saail' %}\r\n          <div><strong>Name:</strong> {{ doc.saail }}</div>\r\n          <div><strong>C/O Name:</strong> {{ doc.care_off }}</div>\r\n          <div><strong>Slip Number:</strong> {{ doc.slip_no }}</div>\r\n\r\n          {% elif doc.party_type == 'Kitchen' %}\r\n          <div><strong>Tag No:</strong> {{ doc.tag_no }}</div>\r\n          <div><strong>Driver ID:</strong> {{ doc.driver_id }}</div>\r\n          <div><strong>Driver Name:</strong> {{ doc.driver_name }}</div>\r\n          <div><strong>Vehicle No:</strong> {{ doc.vehicle_no }}</div>\r\n          {% endif %}\r\n        </div>\r\n      </div>\r\n\r\n      <table style=\"width: 100%; border-collapse: collapse; margin-bottom: 5mm;\">\r\n        <thead>\r\n          <tr style=\"background: #2c3e50; color: #fff;\">\r\n            <th style=\"border: 1px solid #ddd; padding: 5px; text-align: left;\">Product Name</th>\r\n            <th style=\"border: 1px solid #ddd; padding: 5px; text-align: right;\">Quantity</th>\r\n          </tr>\r\n        </thead>\r\n        <tbody>\r\n          {% set total_qty = 0 %}\r\n          {% for item in doc.gate_pass_item %}\r\n          {% set total_qty = total_qty + (item.qty | float) %}\r\n          <tr style=\"background-color: {{ loop.index0 % 2 == 0 and '#f8f9fa' or '#fff' }};\">\r\n            <td style=\"border: 1px solid #ddd; padding: 5px;\">{{ item.item }}</td>\r\n            <td style=\"border: 1px solid #ddd; padding: 5px; text-align: right;\">{{ item.qty }}</td>\r\n          </tr>\r\n          {% endfor %}\r\n        </tbody>\r\n        <tfoot>\r\n          <tr style=\"background: #ecf0f1;\">\r\n            <td style=\"border: 1px solid #ddd; padding: 5px; text-align: right; font-weight: bold;\">Total</td>\r\n            <td style=\"border: 1px solid #ddd; padding: 5px; text-align: right; font-weight: bold;\">{{ total_qty }}</td>\r\n          </tr>\r\n        </tfoot>\r\n      </table>\r\n\r\n      <div style=\"text-align: center; font-size: 10px; margin-top: 5mm;\">\r\n        <div style=\"margin-bottom: 3px;\">Thank You!</div>\r\n      </div>\r\n    </div>\r\n    {% endfor %}\r\n  </div>\r\n  {% endif %}\r\n  \r\n  \r\n  <!--saail-->\r\n  \r\n  {% if doc.party_type == 'Saail'